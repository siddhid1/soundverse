# Copy to .env and fill in. NEVER commit real secrets or provider keys.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (local compose default)
DATABASE_URL=postgres://soundverse:soundverse@localhost:5432/soundverse

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=soundverse-audio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
AUDIO_URL_TTL_SEC=900

# Dashboard sessions (32+ random chars in production)
SESSION_SECRET=dev-session-secret-change-me-32chars
# Key used to encrypt webhook signing secrets at rest
WEBHOOK_CRYPT_KEY=dev-webhook-crypt-key-change-me!!

# Music provider: "mock" (default, free, used by tests + test keys) or "elevenlabs"
PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music-v1

APP_BASE_URL=http://localhost:3000
