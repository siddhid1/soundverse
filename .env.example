# Copy to .env and fill in. NEVER commit real secrets or provider keys.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (local compose default)
DATABASE_URL=postgres://soundverse:soundverse@localhost:5432/soundverse

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
# Host baked into presigned download URLs. Defaults to S3_ENDPOINT; override
# when the data plane differs (compose: internal http://minio:9000, public
# http://localhost:9000).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=soundverse-audio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
AUDIO_URL_TTL_SEC=900

# Dashboard sessions (32+ random chars in production)
SESSION_SECRET=dev-session-secret-change-me-32chars
# Key used to encrypt webhook signing secrets at rest
WEBHOOK_CRYPT_KEY=dev-webhook-crypt-key-change-me!!

# Music provider: "mock" (default, free, used by tests + test keys) or "elevenlabs"
PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MUSIC_MODEL=music-v1

# Worker tuning
WORKER_POLL_MS=500
WORKER_LEASE_SEC=120
WORKER_MAX_ATTEMPTS=3
PROVIDER_TIMEOUT_MS=120000
MOCK_LATENCY_MS=2000
MOCK_FAIL_RATE=0

# Webhook dispatcher tuning
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_RETRY_BASE_SEC=5
WEBHOOK_MAX_BYTES=1048576
# Test/dev escape hatch for local stub receivers. NEVER enable in production:
# it permits http + private/loopback webhook destinations. (Metdata IPs stay
# blocked regardless.) Docker compose enables it so the quickstart receiver works.
WEBHOOK_ALLOW_PRIVATE_IPS=false

APP_BASE_URL=http://localhost:3000
